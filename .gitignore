*.pyc
*.pyo
*.pyd
__pycache__/

# 忽略虚拟环境文件夹
venv/
env/
*.env
.venv/

# 忽略 IDE 配置文件
.idea/
.vscode/

# 忽略操作系统生成的文件
.DS_Store  # macOS 系统的文件
Thumbs.db  # Windows 系统的文件

# 忽略日志文件
*.log

# 忽略测试覆盖率文件
.coverage

# 忽略 Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# 忽略环境配置文件
.env
*.env

# 忽略pip的缓存
pip-log.txt
pip-delete-this-directory.txt

# 忽略其他敏感文件
*.sqlite3
*.db
